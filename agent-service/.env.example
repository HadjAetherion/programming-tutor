# ===== 智谱 GLM 云端大模型 =====
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# ===== Ollama 端侧小模型 =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ===== 数据库（与 Go 后端共用同一个 PostgreSQL） =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=programming_tutor
DB_SSLMODE=disable

# ===== 成本单价（元 / 1K tokens） =====
# 请按智谱官方当前定价填写；为 0 时 cost_yuan 记 0，但 token 与延迟照常记录。
ZHIPU_INPUT_PRICE_PER_1K=0
ZHIPU_OUTPUT_PRICE_PER_1K=0


# ===== 路由策略（实验用） =====
# 留空 = 规则式路由（实验组）；设为 cloud = 强制全云端（对照组）
ROUTER_FORCE_TIER=
# 累计成本超过该值后强制走端侧（0 = 不启用）
ROUTER_BUDGET_YUAN=0
